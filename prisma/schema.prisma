generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Trip {
  id            String   @id @default(cuid())
  clerkUserId   String

  destination   String
  startDate     DateTime
  endDate       DateTime

  budget        String
  travelers     Int

  preferences   String?

  itinerary     Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}